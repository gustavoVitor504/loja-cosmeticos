PORT=4000
# Origem(ns) do front autorizadas no CORS, separadas por vírgula
CORS_ORIGIN=http://localhost:3000
SUPABASE_URL=https://xxxx.supabase.co
# Chave service_role (Settings > API). NUNCA exponha no front.
SUPABASE_SERVICE_ROLE_KEY=
# Bucket do Storage para a foto da consultora
SUPABASE_STORAGE_BUCKET=consultant-assets
